# Copy this file to .env (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Do NOT commit real secrets. .env is gitignored.

# Database (MongoDB Atlas)
MONGODB_URI=

# Cloudinary (Image Management)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentication
JWT_SECRET=
NEXTAUTH_SECRET=
# Local: http://localhost:3000 — On Vercel set to your deployed URL, e.g. https://techpulse-website.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Server Config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
